{% extends 'base.html.twig' %}

{% block body %}
<div class="text-center mt-5">

{% if app.user %}
    <h1 class="display-4 text-primary">Bonjour {{app.user.pseudo}} !<br>Bienvenue sur TaskFlow</h1>
        <p class="lead">Votre gestionnaire de tâches simple, rapide et efficace.</p>

    <a href="{{ path('app_login') }}" class="btn btn-outline-light ms-3">
    </a>
    <a href="{{ path('task_index') }}" class="btn btn-outline-primary btn-lg mt-3">
        📋 Voir mes tâches
    </a>   
    <a href="{{ path('home_presentation') }}" class="btn btn-outline-primary btn-lg mt-3">
        ℹ️ Présentation du projet TaskFlow
    </a>
          
    {% else %}
        <h1 class="display-4 text-primary">Bienvenue sur TaskFlow</h1>
            <p class="lead">Votre gestionnaire de tâches simple, rapide et efficace.</p>
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-lg mt-3">
            👤 Veuillez vous connecter pour accéder à l’application et gérer vos tâches.
            </a>
    <br>
    <a href="{{ path('home_presentation') }}" class="btn btn-outline-primary btn-lg mt-3">
        ℹ️ Présentation du projet TaskFlow
    </a>
{% endif %}
    
</div>
{% endblock %}

