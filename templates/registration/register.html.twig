{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}

<div class="container mt-5 mb-5 text-center">

    <h1 class="h3 mb-3 font-weight-normal">Inscrivez-vous</h1>

    <div class="card p-4 shadow-lg">

        {{ form_start(registrationForm) }}

        <!-- Pseudo -->
        <div class="mb-3 text-start">
            <label class="form-label fw-bold">Pseudo</label>
            {{ form_widget(registrationForm.pseudo, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(registrationForm.pseudo) }}
        </div>
        
        <!-- Email -->
        <div class="mb-3 text-start">
            <label class="form-label fw-bold">Email</label>
            {{ form_widget(registrationForm.email, {
                'attr': {'class': 'form-control'}
            }) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <!-- Password -->
        <div class="mb-3 text-start">
            <label class="form-label fw-bold">Mot de passe</label>
            {{ form_widget(registrationForm.plainPassword, {
                'attr': {'class': 'form-control'}
            }) }}
            {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <!-- Checkbox "terms" -->
        <div class="checkbox mb-3 text-center">
            <label class="d-inline-flex align-items-center gap-2">
                J’accepte les conditions
                {{ form_widget(registrationForm.agreeTerms) }}
            </label>
            <!-- Affichage de l’erreur si non coché -->
            <div class="text-danger mt-1">
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>
        </div>

        <!-- Bouton -->
        <button class="btn btn-lg btn-primary w-100 mt-3" type="submit">
            🔐 S'enregistrer
        </button>

        {{ form_end(registrationForm) }}
    </div>

    <div class="mt-3">
        Déjà un compte ?
        <a href="{{ path('app_login') }}" class="fw-bold">
            Connectez-vous ici
        </a>
    </div>
</div>
{% endblock %}
